person1.sleeping()



class CEO:
    def __init__(self, login, password):
        self.login = login
        self.password = password

    def manages(self, project_name):
        return f"CEO ({self.login}) project '{project_name}' ko manage kar rahe hain."

    def assigns(self, employee_name):
        return f"CEO ({self.login}) ne employee '{employee_name}' ko task assign kiya hai."

    def controls(self, report_name):
        return f"CEO ({self.login}) report '{report_name}' ko control kar rahe hain."


class Project:
    def __init__(self, id_num, tasks_id, access, name):
        self.id = id_num
        self.tasks_id = tasks_id  # List of numbers
        self.access = access      # List of numbers
        self.name = name


class Report:
    def __init__(self, time, date, task, project):
        self.time = time
        self.date = date
        self.task = task
        self.project = project


class Employee:
    def __init__(self, id_num, login, password):
        self.id = id_num
        self.login = login
        self.password = password


# --- Example Usage ---

# CEO object banana
ceo1 = CEO(login="admin_ceo", password="securepassword123")

# Project object banana
project1 = Project(id_num=101, tasks_id=[1, 2, 3], access=[0, 1], name="IndusWeave Pipeline")

# Report object banana
report1 = Report(time=10, date="2026-10-31", task="Data Cleaning", project="IndusWeave Pipeline")

# Employee object banana
emp1 = Employee(id_num=501, login="emp_rizwan", password="mypassword")

# Methods call karna
print(ceo1.manages(project1.name))
print(ceo1.assigns(emp1.login))
print(ceo1.controls(report1.task))








