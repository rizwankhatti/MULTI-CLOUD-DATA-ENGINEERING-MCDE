





class cars():
    def __init__(self, name, model,year, color): # constructor
        self.name =  name
        self.model =  model
        self.year = year
        self.color = color
    def run(self): # method 1
        print(f"{self.name} is running")

    def stop(self): # method 2
        print(f"{self.name} is stopped")
        


obj_suzuki = cars('Alto', 'VXL', 2026, 'Grey')


obj_suzuki.name


obj_suzuki.year


obj_suzuki.run


obj_suzuki.stop





class human:
    # adding class variable
    city = "Karachi"
    country = "Pakistan"
    def __init__(self,name,color,weight,height,gender):
        self.name = name
        self.color = color
        self.weight= weight
        self.height = height
        self.gender = gender

    def breathing(self):
        print(f"{self.name} is taking a deep breath")

    def sleeping(self):
        print(f"{self.name} is fast asleep and dreaming")

    def working(self):
        print(f"{self.name} is focused and hard at work")




qasim = human("Qasim", "brown", 70, 5.9, "male")
ayesha = human


